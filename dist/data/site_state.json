    "timeline": [
      {
        "date": "2026年4月30日",
        "tag": "心动启航",
        "title": "相恋与故事的开篇",
        "desc": "从这一天开始，两人的宇宙有了专属的频率。“全世界仅此一个的我，尽情幸福吧。” 对话框亮起的每一次震动，都是初夏最心动的回响。",
        "quote": "照片里加了什么 我不懂 好幸福。",
        "images": [
          "./images/timeline_05_1.jpg",
          "./images/timeline_05_2.jpg"
        ]
      },
      {
        "date": "2026年5-6月",
        "tag": "新的回忆",
        "title": "一周一次的商场美食搜寻 在盛香亭吃“进口龙虾”",
        "desc": "最开心的莫过于在万家丽做完美甲去看电影然后去吃盛香亭啦，我们点了最爱的卤味，你开玩笑说这是“进口小龙虾”，逗得我们哈哈大笑。每次坐在餐桌前，只要和你在一起，每一口食物都是甜蜜的味道。",
        "quote": "“我今天给你修眉，我想吃盛香亭”",
        "images": [
          "./images/uploads/slot_1793771814053_244.jpg?v=2",
          "./images/uploads/slot_1793787192052_877.mov"
        ]
      },
      {
        "date": "2026年7月",
        "tag": "暑假异地分开的一个月",
        "title": "跨越屏幕的相思 · 每天互道早晚安与日常播报",
        "desc": "放暑假各自回家，相隔两地整整分开了一个月。每天早起报备、互道晚安，“再奖励你一张嘛，女神一下”，每一顿饭、每一组生活自拍都毫无保留地发给对方，深夜长长的语音与视频连线，把距离消融在温柔的陪伴里。",
        "quote": "我越来越离不开你了，我只想好好和你在一起。",
        "images": [
          "./images/timeline_07_1.jpg",
          "./images/timeline_07_2.jpg"
        ]
      },
      {
        "date": "2026年8月",
        "tag": "久别重逢 · 彩云之南",
        "title": "丽江与大理自驾漫游记 · 515张相片峰值",
        "desc": "熬过了一个月的分开，终于在盛夏重聚，直奔云南开启浪漫自驾之旅！自驾穿梭在苍山与洱海的环海公路上，吹着傍晚清凉微甜的晚风；漫步在丽江古城光洁温润的石板街与夜色灯火中，牵着你的手一路走一路拍，单日聊天记录狂飙515条，写满了我们最绚烂的夏日记忆。",
        "quote": "大理的晚风太治愈了，自驾在环海路上的感觉好自由，这一路有你真好。",
        "images": [
          "./images/uploads/slot_1793787287711_571.mov",
          "./images/timeline_08_2.jpg",
          "./images/uploads/slot_1793094914212_460.jpeg?v=2"
        ]
      },
      {
        "date": "2026年9月 ~ 10月",
        "tag": "校园同频 · 日常相守",
        "title": "KFC专属套餐、公园散步与日常相守",
        "desc": "“吃薯条要蘸酱”、去公园散步吹晚风……无论平时多忙，只要两个人在一起吃顿KFC、在公园石板路边牵手漫步，平凡的小日子就被填得满满当当。",
        "quote": "“吃KFC蘸酱，再去公园散散步。”",
        "images": [
          "./images/uploads/slot_1793271441782_249.jpg?v=2",
          "./images/uploads/slot_1793271466421_123.jpg?v=2"
        ]
      },
      {
        "date": "2026年10月 ~ 11月",
        "tag": "秋季开学 · 成熟磨合",
        "title": "把小情绪化作更懂彼此的养分 · 剩下的交给我",
        "desc": "旅行归来回到校园常态，面对琐碎日常中的小情绪，展现出极高的情商与温柔担当。“好啦不委屈，打嘴嘴好不好”、“我是想通过这个让我们磨合的更好，剩下的交给我”。从初夏走到金秋，每一次敞开心扉的沟通，都让我们把手牵得更紧。",
        "quote": "老婆说我坏坏我可伤心了[委屈] —— 好啦不委屈，打嘴嘴好不好？",
        "images": [
          "./images/uploads/slot_1793153782448_774.png?v=2",
          "./images/uploads/slot_1793153725108_221.jpeg?v=2"
        ]
      }
